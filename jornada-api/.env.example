# Copie para .env e ajuste: cp .env.example .env

NODE_ENV=development
PORT=3000

# Origens permitidas no CORS, separadas por vírgula (use o link do front em produção).
# Em desenvolvimento, "*" libera tudo.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Segredo do JWT. Em produção use um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-desenvolvimento
JWT_EXPIRES_IN=8h

# Banco: se DATABASE_URL estiver vazio, usa SQLite no arquivo abaixo (desenvolvimento).
# Em produção (Render/Railway) defina DATABASE_URL com a string do PostgreSQL.
DATABASE_URL=
SQLITE_FILE=./dev.sqlite3
# SSL no PostgreSQL: por padrão ligado em produção. Coloque false se o provedor
# der uma URL interna sem SSL (ex.: Railway).
# DATABASE_SSL=false

# Rate limit por IP a cada 15 minutos (valores padrão; só mude se precisar).
# Atenção: muitos alunos podem sair pelo mesmo IP (wi-fi da faculdade), não aperte demais.
# RATE_LIMIT_GERAL=600
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_INSCRICOES=30
# RATE_LIMIT_CONSULTA=10   (consulta pública de certificado por CPF + e-mail)
# RATE_LIMIT_DOWNLOAD=10   (download do certificado em PDF; contador separado da consulta)

# Usuários criados pelo seed (etapa 2). Troque as senhas em produção.
SEED_ADMIN_EMAIL=admin@jornada.local
SEED_ADMIN_SENHA=trocar-admin-123
SEED_PROFESSOR_EMAIL=professor@jornada.local
SEED_PROFESSOR_SENHA=trocar-professor-123

# ---------------------------------------------------------------------------
# E-mail dos certificados (POST /api/certificados/emitir). Escolha UM modo:
#
# 1) Resend (API HTTPS). RECOMENDADO em produção: o Render (plano gratuito) bloqueia as portas SMTP
#    25/465/587 e o Railway só libera SMTP no plano Pro. Crie a chave em resend.com.
# RESEND_API_KEY=
#
# 2) SMTP (Gmail com senha de app, Brevo, Mailtrap...). Em desenvolvimento, SMTP_HOST pode ficar vazio:
#    o sistema usa o Ethereal (caixa de teste) e imprime no terminal o link para ver o e-mail.
#    Teste local sem internet: Mailtrap / Mailpit (SMTP_HOST=localhost, SMTP_PORT=1025, sem usuário e senha).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
#
# Remetente (obrigatório em produção). Com Resend, use um endereço de domínio verificado
# (ou onboarding@resend.dev nos testes). Exemplo: Jornada Acadêmica <certificados@seudominio.com>
# EMAIL_FROM=
